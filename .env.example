# Copy to .env.local for local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_THEME=system
JWT_SECRET=replace-with-a-random-local-secret
# LAN IPv4 addresses are auto-discovered by next.config.ts.
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,0.0.0.0

# Leave these unset locally to use SQLite and ./uploads/.
# DATABASE_URL=postgresql://...
# B2_ENDPOINT=...
# B2_KEY_ID=...
# B2_APPLICATION_KEY=...
# B2_BUCKET_NAME=...
# B2_REGION=us-east-005
