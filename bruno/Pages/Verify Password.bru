meta {
  name: Verify Password & Get JWT Token
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/pages/{{slug}}/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password": "mysecretpassword123"
  }
}

docs {
  POST /api/pages/:slug/verify — exchange passphrase for a JWT (HS256, 24h,
  payload `{slug}`). The post-response script below auto-saves it into the
  `token` environment variable for all protected calls. Uniform 401 on
  failure (no existence oracle). Strict rate limit: 5 attempts / 60s per IP.
}

script:post-response {
  const body = res.getBody();
  if (body && body.token) {
    bru.setEnvVar("token", body.token);
  } else {
    bru.setEnvVar("token", "");
  }
}
