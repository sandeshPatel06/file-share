meta {
  name: Password Protect Workspace
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/pages/{{slug}}/password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "password": "mysecretpassword123"
  }
}

docs {
  PATCH /api/pages/:slug/password — set (`{"password": "..."}` min 6 chars)
  or clear (`{"password": null}`) the workspace passphrase.
  Bearer token required only if the page is ALREADY protected; 404 if missing.
  Use POST /api/pages/:slug/verify to obtain a JWT after setting.
}
