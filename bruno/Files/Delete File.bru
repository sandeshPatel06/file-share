meta {
  name: Delete File from Vault
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/pages/{{slug}}/files/{{fileId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

docs {
  DELETE /api/pages/:slug/files/:fileId — deletes one file scoped to the
  workspace (fileId + slug), cleans B2/local objects, emits `files_updated`.
  `{{fileId}}` is auto-filled by the Upload request script (or paste one from
  List Files). Bearer token required when the page is password-protected.
}
