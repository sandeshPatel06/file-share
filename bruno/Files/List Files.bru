meta {
  name: List Space Files
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/pages/{{slug}}/files
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

docs {
  GET /api/pages/:slug/files — vault listing, newest first.
  `uploadedAt` is `{seconds: <unix>}`. Bearer token required only when the
  page is password-protected.
}
